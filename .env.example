# ---- Claude (obligatoire pour l'analyse) ----
# Clé API Anthropic. Alternative : `ant auth login` (profil OAuth) et laisser vide.
ANTHROPIC_API_KEY=

# Modèle principal (synthèses, chat, programmes). Défaut : claude-opus-5
APOLLON_MODEL=claude-opus-5
# Modèle pour les tâches de masse (classification de milliers de scrutins, tweets).
# Défaut : claude-opus-5. Levier de coût : claude-sonnet-5 (≈2,5x moins cher).
APOLLON_MODEL_BULK=claude-opus-5
# Plafond de dépense par job d'analyse (USD). Le job s'arrête proprement au-delà.
APOLLON_BUDGET_PER_JOB_USD=25

# ---- Base de données ----
APOLLON_DB_PATH=./data/apollon.db

# ---- X / Twitter (optionnel) ----
# Créer une app sur https://developer.x.com, type "Web App", callback :
#   http://localhost:3000/api/x/callback
# Depuis février 2026, X facture à l'usage (~0,005 $ par tweet lu). Pas de palier gratuit.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Alternative "app only" (lecture seule, sans connecter votre compte) :
X_BEARER_TOKEN=
# Plafond de tweets lus par rafraîchissement (contrôle du coût X)
X_MAX_READS_PER_REFRESH=2000

# URL publique de l'app (pour le callback OAuth X)
APOLLON_BASE_URL=http://localhost:3000
